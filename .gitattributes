# 统一换行符，避免 Windows/Linux 协作时的全文 diff
* text=auto

# Maven wrapper：LF 硬约束（CRLF 会破坏 .mvn/maven.config 与 mvnw 脚本）
.mvn/maven.config text eol=lf
.mvn/wrapper/maven-wrapper.properties text eol=lf
mvnw text eol=lf

# superpowers 技能脚本：LF 硬约束（bash/node 脚本遇 CRLF 会失效）
*.sh text eol=lf
.claude/skills/**/scripts/* text eol=lf

# Windows 脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
*.gz binary
*.ttf binary

{
  "name": "turing-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "图灵测试平台 - 前端工程（React 18.2 + TS 5.3 + Vite 5 + Ant Design + Tailwind CSS）",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:style": "node scripts/check-style.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@monaco-editor/react": "^4.6.0",
    "@reduxjs/toolkit": "^2.3.0",
    "antd": "^6.6.6",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "lucide-react": "^0.454.0",
    "mermaid": "^10.9.1",
    "monaco-editor": "^0.52.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.28.0",
    "reactflow": "^11.11.4",
    "recharts": "^2.13.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.16.11",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "postcss": "^8.4.47",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.3.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.8"
  }
}
